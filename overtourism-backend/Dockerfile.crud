FROM python:3.12-bookworm

COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

# Copy the project into the image
ADD . /app

WORKDIR /app
RUN uv sync --extra log

ENV PATH="/app/.venv/bin:$PATH"

RUN useradd -m -u 8877 nonroot
RUN mkdir -p /app/overtourism/overtourism/database && chown -R 8877:8877 /app
USER 8877

EXPOSE 8000

ENV CRUD_UVICORN_WORKERS=2

# Run the CRUD FastAPI application with the service log format.
ENTRYPOINT ["sh", "-c", "python -m overtourism.overtourism.bootstrap && exec uvicorn overtourism.overtourism.app:app --host 0.0.0.0 --port 8000 --workers \"${CRUD_UVICORN_WORKERS:-2}\" --log-config /app/uvicorn_log_config.json \"$@\"", "sh"]
